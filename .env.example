# Replace both secrets with long, random values before deployment.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
POSTGRES_PASSWORD=marketdesk-local
REDIS_PASSWORD=marketdesk-local
WEB_ORIGIN=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

# Optional SMTP alert delivery. In-app notifications work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=

# Optional Nest Observe telemetry credentials.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
